PORT=3000

# Redis (used by BullMQ queue and scheduler)
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.example.com

# JWT — generate a random secret for production
JWT_SECRET=super-secret-dev-key-change-me
JWT_EXPIRY=7d

# Resend — https://resend.com (get a free API key)
RESEND_API_KEY=re_your_api_key_here
# The "from" address must be a verified domain in your Resend account
MAIL_FROM=Conduit <noreply@yourdomain.com>

# Google Gemini — https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
