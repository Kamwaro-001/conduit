PORT=3000

# Redis (used by BullMQ queue and scheduler)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=job
DB_PASSWORD=protection
DB_DATABASE=conduit-db

# Initial Admin User (for seeding)
ADMIN_EMAIL=admin@conduit.com
ADMIN_PASSWORD=admin123

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.example.com

# JWT — generate a random secret for production
JWT_SECRET=super-secret-dev-key-change-me
JWT_EXPIRY=7d

# Resend
RESEND_API_KEY=re_your_api_key_here
# The "from" address 
MAIL_FROM=Conduit <noreply@yourdomain.com>

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

NODE_ENV=
